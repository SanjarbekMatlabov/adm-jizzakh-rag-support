# ===========================================
# ADM Jizzakh Kia Customer Support AI Assistant
# Environment Variables
# ===========================================

# OpenAI API key (required)
OPENAI_API_KEY=sk-your-openai-api-key

# GitHub Personal Access Token with "repo" scope (required for ticket creation)
GITHUB_TOKEN=ghp_your-github-token

# Target repository for support tickets in "owner/repo" format
GITHUB_REPOSITORY=your-org/your-support-repo

# Company information
COMPANY_NAME=ADM Jizzakh
COMPANY_EMAIL=support@adm.uz
COMPANY_PHONE=+998551522222

# Model configuration (optional, defaults provided)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
